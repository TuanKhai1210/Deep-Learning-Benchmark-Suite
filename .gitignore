# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging
build/
dist/
downloads/
.eggs/
*.egg-info/
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Credentials and secrets
.env
.env.*
!.env.example
secrets/
credentials/
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/

# Tests and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.tox/
.nox/
.hypothesis/

# Type checking and linting
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Local data: keep the usage note, ignore actual datasets
/data/*
!/data/README.md
/datasets/

# Model checkpoints: keep the usage note, ignore model weights
/checkpoints/*
!/checkpoints/README.md
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.safetensors

# Experiment outputs: keep the run specification, ignore generated artifacts
/runs/*
!/runs/README.md
/logs/
/wandb/
/mlruns/
/artifacts/
/outputs/

# Documentation build outputs
docs/_build/
/site/
/docs/_site/
/docs/.jekyll-cache/

# IDE and editor settings
.vscode/
.idea/
*.code-workspace
*~
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
